{
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "jsxBracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": [
    "prettier-plugin-tailwindcss",
    "@trivago/prettier-plugin-sort-imports"
  ],
  "tailwindFunctions": ["tv"],
  "importOrder": [
    "<THIRD_PARTY_MODULES>",
    "^@/app/",
    "^@/assets/",
    "^@/components/",
    "^@/constants/",
    "^@/hooks/",
    "^@/modules/",
    "^@/shared/",
    "^@/styles/",
    "^@/tw/",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
